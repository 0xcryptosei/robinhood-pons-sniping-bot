ROBINHOOD_WSS_URL=wss://api-robinhood-mainnet-archive.n.dwellir.com/your-api-key
# Optional HTTP RPC for reading token metadata. Defaults to ROBINHOOD_WSS_URL with https://
# ROBINHOOD_RPC_URL=https://api-robinhood-mainnet-archive.n.dwellir.com/your-api-key
# Historical backfill via eth_getLogs. Set to 0 to skip (required on plans without getLogs support).
BACKFILL_BLOCKS=0

# Buy settings
BUY_ENABLED=true
PRIVATE_KEY=
BUY_AMOUNT_ETH=0.01
BUY_DELAY_MS=2000
# Skip buy while curve snipe tax is above this (basis points). 100 = 1%, 0 = wait for zero tax.
MAX_SNIPE_TAX_BPS=100
SNIPE_TAX_POLL_MS=200
SNIPE_TAX_MAX_WAIT_MS=8000
BUY_RESUME_ON_FAILURE=false
